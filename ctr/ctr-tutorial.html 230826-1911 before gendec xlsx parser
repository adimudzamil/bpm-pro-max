<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
<title>CTR Autofill – Tutorial</title>
<style>
  /* ── Same light theme as CTR.html ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #f8fafc;
    --surface: #ffffff;
    --surface2: #f1f5f9;
    --border: #e2e8f0;
    --border-bright: #cbd5e1;
    --text: #1e293b;
    --text-muted: #64748b;
    --text-dim: #94a3b8;
    --accent: #2563eb;
    --accent-dim: rgba(37,99,235,0.1);
    --accent-glow: rgba(37,99,235,0.2);
    --accent-hover: #1d4ed8;
    --red: #dc2626;
    --green: #16a34a;
    --radius: 12px;
    --radius-sm: 8px;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    padding: 20px;
    line-height: 1.6;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
    background: var(--surface);
    border-radius: var(--radius);
    padding: 40px 32px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
    border: 1px solid var(--border);
  }

  h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 4px;
  }

  h1 span { color: var(--accent); }

  .subtitle {
    font-size: 16px;
    color: var(--text-muted);
    margin-bottom: 32px;
    border-bottom: 2px solid var(--border);
    padding-bottom: 16px;
  }

  h2 {
    font-size: 22px;
    font-weight: 700;
    margin-top: 32px;
    margin-bottom: 12px;
    color: var(--text);
  }

  h3 {
    font-size: 17px;
    font-weight: 600;
    margin-top: 20px;
    margin-bottom: 8px;
    color: var(--text);
  }

  p {
    margin-bottom: 12px;
    color: var(--text);
    font-size: 15px;
  }

  ul, ol {
    margin: 8px 0 16px 24px;
    color: var(--text);
    font-size: 15px;
  }

  li { margin-bottom: 4px; }

  .note {
    background: var(--surface2);
    border-left: 4px solid var(--accent);
    padding: 12px 16px;
    border-radius: var(--radius-sm);
    margin: 16px 0;
    font-size: 14px;
  }

  .note.warning {
    border-left-color: var(--red);
  }

  .note.success {
    border-left-color: var(--green);
  }

  .step-card {
    background: var(--surface2);
    border-radius: var(--radius-sm);
    padding: 16px 20px;
    margin: 12px 0;
    border: 1px solid var(--border);
  }

  .step-card .step-number {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    width: 28px;
    height: 28px;
    text-align: center;
    line-height: 28px;
    border-radius: 50%;
    margin-right: 10px;
  }

  .step-card strong {
    font-size: 16px;
  }

  .button-demo {
    display: inline-block;
    padding: 8px 18px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 13px;
    margin: 2px 0;
  }

  .btn-blue {
    background: var(--accent);
    color: #fff;
  }

  .btn-gray {
    background: transparent;
    border: 1px solid var(--border-bright);
    color: var(--text);
  }

  .btn-green {
    background: var(--green);
    color: #fff;
  }

  .btn-upload-demo {
    background: var(--accent);
    color: #fff;
    padding: 12px 28px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 15px;
    display: inline-block;
    box-shadow: 0 4px 12px var(--accent-glow);
  }

  .badge-demo {
    display: inline-block;
    background: var(--accent-dim);
    border: 1px solid var(--accent);
    color: var(--accent);
    padding: 2px 12px;
    border-radius: 100px;
    font-size: 11px;
    font-weight: 500;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 12px 0;
  }

  @media (max-width: 600px) {
    .grid-2 { grid-template-columns: 1fr; }
    .container { padding: 20px 16px; }
    h1 { font-size: 26px; }
  }

  .icon-box {
    display: inline-block;
    font-size: 20px;
    margin-right: 6px;
  }

  .footer {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 2px solid var(--border);
    font-size: 13px;
    color: var(--text-muted);
    text-align: center;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0;
    font-size: 14px;
  }
  th, td {
    border: 1px solid var(--border);
    padding: 8px 12px;
    text-align: left;
  }
  th {
    background: var(--surface2);
    font-weight: 600;
  }
</style>
